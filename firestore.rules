rules_version = '2';

// Comments are written directly from the browser. This app authenticates with
// Supabase + its own backend JWT, NOT Firebase Auth, so `request.auth` is always
// null here and rules cannot verify the caller's identity.
//
// Consequence: ownership (only the author may delete) is enforced CLIENT-SIDE
// (see web/src/components/CommentSection.tsx). These rules only validate the
// shape/size of writes and keep reads public.
//
// If stronger guarantees are needed later: mint a Firebase custom token on the
// backend (Admin SDK) keyed to the user id, call signInWithCustomToken on the
// client, then gate create/delete on `request.auth.uid == resource.data.user_id`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /checkpoints/{checkpointId}/comments/{commentId} {
      allow read: if true;

      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.user_id is string;

      allow update: if false;

      // Ownership enforced client-side (no Firebase Auth identity available).
      allow delete: if true;
    }

    // Best-effort participant index for client-side comment notification fanout.
    // The backend should own this later; for now rules only validate shape.
    match /checkpoints/{checkpointId}/comment_participants/{userId} {
      allow read: if true;

      allow create, update: if request.resource.data.user_id is string
                            && request.resource.data.user_id == userId;

      allow delete: if false;
    }

    // In-app notifications, written client-side at the action site (comment /
    // follow / reaction / chat). No Firebase Auth → recipient/actor can't be
    // verified; reads are public and creates only shape-validated.
    match /users/{uid}/notifications/{notifId} {
      allow read: if true;

      allow create: if request.resource.data.type in ['comment', 'mention', 'follow', 'unfollow', 'reaction', 'chat_message']
                    && request.resource.data.actor_id is string;

      allow update, delete: if false;
    }

    // ── Chat rooms ──────────────────────────────────────────────────────

    match /rooms/{roomId} {
      allow read: if true;

      allow create: if request.resource.data.type in ['dm', 'group']
                    && request.resource.data.members is list
                    && request.resource.data.created_by is string;

      // Allow any update — client-side enforced (same trade-off as comments).
      // Room updates include: last_message preview, group metadata (name/avatar/members),
      // and read timestamps (read.{userId}).
      allow update: if true;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;

        allow create: if request.resource.data.room_id == roomId
                      && request.resource.data.sender_id is string
                      && (request.resource.data.text is string || request.resource.data.image_url is string);

        allow update, delete: if false;
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
