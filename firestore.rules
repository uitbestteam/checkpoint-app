rules_version = '2';

// Comments are written directly from the browser. This app authenticates with
// Supabase + its own backend JWT, NOT Firebase Auth, so `request.auth` is always
// null here and rules cannot verify the caller's identity.
//
// Consequence: ownership (only the author may delete) is enforced CLIENT-SIDE
// (see web/src/components/CommentSection.tsx). These rules only validate the
// shape/size of writes and keep reads public.
//
// If stronger guarantees are needed later: mint a Firebase custom token on the
// backend (Admin SDK) keyed to the user id, call signInWithCustomToken on the
// client, then gate create/delete on `request.auth.uid == resource.data.user_id`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /checkpoints/{checkpointId}/comments/{commentId} {
      allow read: if true;

      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.user_id is string
                    && request.resource.data.username is string;

      allow update: if false;

      // Ownership enforced client-side (no Firebase Auth identity available).
      allow delete: if true;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
